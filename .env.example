# ============================================================
# Movie Booking Backend — Environment Variables
# Copy this file: cp .env.example .env
# Fill in your actual values. NEVER commit .env to git.
# ============================================================

# ── Django Core ──────────────────────────────────────────────
SECRET_KEY=your-50-char-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────
# Option 1: DATABASE_URL (Neon / Supabase / Vercel Postgres)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option 2: SQLite (local dev — no PostgreSQL needed)
USE_SQLITE=True

# Option 3: Local PostgreSQL
# USE_SQLITE=False
# DB_NAME=movie_booking_db
# DB_USER=movie_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# ── Redis (Celery Broker) ─────────────────────────────────────
# Local Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# Upstash Redis (production)
# REDIS_URL=rediss://default:password@host:port
# CELERY_BROKER_URL=rediss://default:password@host:port

# ── Email ─────────────────────────────────────────────────────
# Development: prints emails to console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production: Gmail SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=Movie Booking <your-email@gmail.com>

# ── App Settings ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:8000
PAGINATION_PAGE_SIZE=20
MAX_SEATS_PER_BOOKING=10

# ── Celery Eager Mode ────────────────────────────────────────
# Set to True for local dev without Redis, or on Vercel serverless
# Tasks will run inline (synchronously) instead of via Redis queue
# USE_CELERY_EAGER=True

# ============================================================
# VERCEL DEPLOYMENT — Environment Variables Needed
# Set all of these in the Vercel dashboard → Project → Settings → Environment Variables
# ============================================================
# SECRET_KEY=your-strong-50-char-secret-key
# DEBUG=False
# VERCEL=1
# ALLOWED_HOSTS=your-project.vercel.app
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=Movie Booking <your-email@gmail.com>
# FRONTEND_URL=https://your-project.vercel.app
# USE_CELERY_EAGER=True

